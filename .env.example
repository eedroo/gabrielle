# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Backoffice — set automatically by the Vercel Neon and Blob integrations
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# BLOB_READ_WRITE_TOKEN=

# Backoffice — add by hand in Vercel (Settings → Environment Variables)
# AUTH_SECRET=        # random, at least 32 characters (openssl rand -base64 48)
# ADMIN_SETUP_CODE=   # any code; needed once to create the first account

# Booking availability (next phase) — Google Calendar
# GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# BOOKING_TIMEZONE=Europe/Berlin
